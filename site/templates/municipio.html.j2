{% extends "base.html.j2" %}
{% block titulo %}{{ m.nome }} ({{ sigla }}) — Observatório Nacional da Fonoaudiologia{% endblock %}
{% block descricao %}Formação e cobertura assistencial em Fonoaudiologia no município de {{ m.nome }}, {{ nome_uf }}.{% endblock %}

{% block conteudo %}

<nav class="migalhas" aria-label="Trilha">
  <a href="{{ depth }}index.html">Panorama</a> ›
  <a href="{{ depth }}uf/{{ sigla }}.html">{{ nome_uf }}</a> ›
  <span>{{ m.nome }}</span>
</nav>

<section class="cabecalho-uf">
  <h1>{{ m.nome }} <span class="sigla-uf">{{ sigla }}</span></h1>
  <p class="linha-contexto">
    {% if m.tem_curso_presencial %}
      Município com oferta presencial de Fonoaudiologia.
    {% elif m.polos_ead %}
      Município sem curso presencial. A formação chega aqui por
      {{ m.polos_ead }} polo{{ 's' if m.polos_ead > 1 else '' }} de EaD.
    {% else %}
      Município sem curso presencial e sem polo de EaD registrado.
    {% endif %}
  </p>
</section>

<section class="secao">
  <h2 class="secao-titulo">Formação</h2>
  <div class="kpis kpis-compacto" data-cartoes>
    {% for campo in ['vagas_presencial', 'cursos_presencial', 'n_ies',
                     'matriculas', 'matriculas_ead', 'concluintes', 'polos_ead'] %}
    <div class="kpi" data-campo="{{ campo }}"
         data-valor="{{ m[campo] if m[campo] is not none else '' }}"></div>
    {% endfor %}
  </div>
</section>

<section class="secao">
  <h2 class="secao-titulo">Cobertura assistencial</h2>
  <div class="kpis kpis-compacto" data-cartoes>
    {% for campo in ['fonoaudiologos_sus', 'estabelecimentos_servico_fono'] %}
    <div class="kpi" data-campo="{{ campo }}"
         data-valor="{{ m[campo] if m[campo] is not none else '' }}"></div>
    {% endfor %}
  </div>
  {% if m.servicos_fono %}
  <p class="nota">
    Serviços declarados no CNES:
    {% for s in m.servicos_fono %}<code>{{ s }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.
    O código antes da barra é o serviço especializado; depois, a classificação.
  </p>
  {% elif m.fonoaudiologos_sus %}
  <p class="nota">
    Há fonoaudiólogo vinculado ao SUS, mas nenhum estabelecimento do município
    declara serviço fonoaudiológico ou auditivo especializado no CNES. As duas
    coisas são medidas diferentes, e é por isso que aparecem separadas.
  </p>
  {% endif %}
</section>

<section class="secao">
  <h2 class="secao-titulo">Contexto estadual</h2>
  <p>
    {{ nome_uf }} tem {{ d.municipios_oferta | numero }} municípios com curso
    presencial, de {{ d.municipios_total | numero }} no total.
  </p>
  <p><a class="botao" href="{{ depth }}uf/{{ sigla }}.html">Ver o estado inteiro</a></p>
</section>

{% endblock %}

{% block scripts %}
<script>
document.querySelectorAll('[data-cartoes] .kpi').forEach(function (cartao) {
  const campo = cartao.dataset.campo;
  const bruto = cartao.dataset.valor;
  const valor = bruto === '' ? null : parseFloat(bruto);
  const valorEl = document.createElement('span');
  valorEl.className = 'kpi-valor';
  valorEl.textContent = fmt(valor, campo);
  if (valor === null) valorEl.classList.add('sem-dados');
  const rotuloEl = document.createElement('span');
  rotuloEl.className = 'kpi-rotulo';
  rotuloEl.textContent = nomeCompleto(campo);
  cartao.appendChild(valorEl);
  cartao.appendChild(rotuloEl);
});
</script>
{% endblock %}
